# PingOne DaVinci Sign-On — environment variables
# Copy this file to .env and fill in your values.

PINGONE_ENV_ID=
PINGONE_CLIENT_ID=
PINGONE_CLIENT_SECRET=

# Regional auth base URL (no trailing slash).
# North America: https://auth.pingone.com
# Europe:        https://auth.pingone.eu
# Asia-Pacific:  https://auth.pingone.asia
PINGONE_AUTH_PATH=https://auth.pingone.com

# Must match a redirect URI registered on your OIDC app in PingOne.
# A non-functional placeholder is fine for this demo (the redirect never
# actually happens — the server captures the code before any redirect).
PINGONE_REDIRECT_URI=http://localhost:3000/callback
