# Worker application credentials — Token Endpoint Auth Method must be Client Secret Basic.
# The app must have roles: Identity Data (read) + PingOne Protect (risk evaluation).
PINGONE_ENV_ID=
PINGONE_CLIENT_ID=
PINGONE_CLIENT_SECRET=

# Auth and API base URLs (no trailing slash).
# Defaults below are for North America. Change suffix to .ca, .eu, or .asia for other regions.
PINGONE_AUTH_PATH=https://auth.pingone.com
PINGONE_API_PATH=https://api.pingone.com

# ID of the Protect risk policy set to evaluate against.
# The policy set must have Anonymous Network Detection enabled and scored above the HIGH threshold.
PINGONE_RISK_POLICY_SET_ID=
