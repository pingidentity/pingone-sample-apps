# PingOne environment ID that owns the Worker application
PINGONE_ENV_ID=

# Worker application credentials (Client Secret Basic)
PINGONE_CLIENT_ID=
PINGONE_CLIENT_SECRET=

# PingOne regional auth base URL — no trailing slash
# North America:  https://auth.pingone.com
# Europe:         https://auth.pingone.eu
# Asia-Pacific:   https://auth.pingone.asia
# Canada:         https://auth.pingone.ca
PINGONE_AUTH_PATH=https://auth.pingone.com

# PingOne regional API base URL — no trailing slash
# North America:  https://api.pingone.com
# Europe:         https://api.pingone.eu
# Asia-Pacific:   https://api.pingone.asia
# Canada:         https://api.pingone.ca
PINGONE_API_PATH=https://api.pingone.com

# ID of the PingOne Protect risk policy set.
# The policy set must have Anonymous Network Detection enabled and its score
# threshold set so that 185.220.101.1 (a Tor exit node, score 80) returns HIGH.
PINGONE_RISK_POLICY_SET_ID=
