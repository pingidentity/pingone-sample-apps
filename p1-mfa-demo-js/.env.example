PINGONE_ENV_ID=
PINGONE_CLIENT_ID=
PINGONE_CLIENT_SECRET=
PINGONE_AUTH_PATH=https://auth.pingone.com
# Note: auth.pingone.com is for North America. Change to .ca, .eu, or .asia depending on region.

# Admin Worker App credentials (from your original PingOne environment, NOT the test env).
# These are the same adminAppID/adminAppSecret you use in the Task 2 Postman collection.
# The app must have Environment Admin role assigned.
PINGONE_ADMIN_ENV_ID=
PINGONE_ADMIN_CLIENT_ID=
PINGONE_ADMIN_CLIENT_SECRET=
