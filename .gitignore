# Environment files
.env

# Go binaries (compiled output matches the directory name pattern)
p1-*/p1-*
p1-*/*.exe

# Node
node_modules/

# Python
__pycache__/
*.pyc
.venv/

# Angular build output and cache
**/client/dist/
**/.angular/

# Local reference docs (not for source control)
POSTMAN_COLLECTIONS.md

# Per-app logo copies (canonical is assets/logo.png)
p1-*/logo.png
p1-*/client/src/logo.png
p1-*/client/src/assets/logo.png

# macOS
.DS_Store
