# Environment files
.env

# Go binaries (each go/ dir produces a binary named after its module)
*/go/p1-*
*/go/*.exe

# Node
node_modules/

# Python
__pycache__/
*.pyc
.venv/

# Angular build output and cache
**/client/dist/
**/.angular/

# Local reference docs (not for source control)
POSTMAN_COLLECTIONS.md

# Per-app logo copies (canonical is assets/logo.png)
*/go/logo.png
*/react/client/src/logo.png
*/angular/client/src/assets/logo.png
# davinci-signon's JS/Python apps serve the logo via /logo.png and need a local copy
davinci-signon/js/logo.png
davinci-signon/python/logo.png
davinci-signon/react/logo.png
davinci-signon/angular/logo.png

# macOS
.DS_Store
