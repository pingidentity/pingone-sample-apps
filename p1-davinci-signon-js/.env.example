# PingOne DaVinci Sign-On — environment variables
#
# PINGONE_AUTH_PATH is the regional base URL for the PingOne auth service.
# North America : https://auth.pingone.com
# Europe        : https://auth.pingone.eu
# Canada        : https://auth.pingone.ca
# Asia-Pacific  : https://auth.pingone.asia

PINGONE_ENV_ID=
PINGONE_CLIENT_ID=
PINGONE_CLIENT_SECRET=
PINGONE_AUTH_PATH=
PINGONE_REDIRECT_URI=
