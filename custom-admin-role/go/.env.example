# Admin Worker App credentials — used to call the PingOne Management API.
# The app must have Environment Admin (or Identity Admin) role assigned.
PINGONE_ADMIN_ENV_ID=
PINGONE_ADMIN_CLIENT_ID=
PINGONE_ADMIN_CLIENT_SECRET=

# The environment the workflow operates in. Can be the same as admin env, or a test env.
PINGONE_TARGET_ENV_ID=

PINGONE_AUTH_PATH=https://auth.pingone.com
PINGONE_API_PATH=https://api.pingone.com/v1
# Note: defaults are for North America. Change to .ca, .eu, or .asia for other regions.
