# PingOne DaVinci Sign-On — environment variables
# Copy this file to .env and fill in your values.

PINGONE_ENV_ID=
PINGONE_CLIENT_ID=
PINGONE_CLIENT_SECRET=

# Regional auth base URL — no trailing slash.
# NA: https://auth.pingone.com
# EU: https://auth.pingone.eu
# AP: https://auth.pingone.asia
# CA: https://auth.pingone.ca
PINGONE_AUTH_PATH=https://auth.pingone.com

# Must match exactly: (1) this value, (2) the authorize request, (3) the PingOne app registration.
PINGONE_REDIRECT_URI=http://localhost:3000/callback
